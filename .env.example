# PostgreSQL
POSTGRES_USER=dialog
POSTGRES_PASSWORD=
POSTGRES_DB=dialog

# Backend
DATABASE_URL=postgresql+asyncpg://dialog:dialog@db:5432/dialog
REDIS_URL=redis://redis:6379/0
LOG_LEVEL=INFO
ENVIRONMENT=development

# fake_partner — заглушка системы заказчика (только для локальной разработки)
FAKE_PARTNER_TOKEN=

# T18: интеграция по новой схеме (заказчик шлёт нам вебхуки, мы отвечаем на
# их эндпоинт) — статичные токены в обе стороны, разные для test/prod.
# Входящие вебхуки POST .../api/v1/partner/{applications,review}:
PARTNER_INBOUND_TOKEN=
# Список IP через запятую; пусто — проверка выключена (заполнить в проде).
PARTNER_IP_ALLOWLIST=
# Исходящие уведомления — их эндпоинт и наш токен для него (значения
# согласовываются с заказчиком, см. docs/integration_contract.md).
PARTNER_OUTBOUND_URL=
PARTNER_OUTBOUND_TOKEN=

# Распознавание фото паспорта (T05)
ANTHROPIC_API_KEY=
OCR_MODEL=claude-sonnet-5
# anthropic (по умолчанию) | fixture — прогон настоящих Celery-задач без ключа
# (см. scripts/e2e_check.py, app/ocr/factory.py)
OCR_PROVIDER_MODE=anthropic
OCR_FIXTURE_PATH=

# Синхронизация реестров МВД/Росфинмониторинга (T08): local (по умолчанию, из
# REGISTRIES_DIR) или http. Рабочие URL выгрузок не подтверждены — см.
# backend/app/registries/downloader.py — не переключать на http вслепую.
REGISTRIES_DOWNLOADER=local
MVD_REGISTRY_URL=
ROSFINMON_REGISTRY_URL=

# ФНС/ФССП (T16): fake (по умолчанию, для тестов и дев) или http — реальные
# публичные сайты (service.nalog.ru/statusnpd.nalog.ru/egrul.nalog.ru,
# is-go.fssp.gov.ru), без ключа доступа — см. app/sources/fns.py, fssp.py.
# Федресурс убран из конвейера целиком (T16).
EXTERNAL_SOURCES_MODE=fake

# БКИ (T11): not_configured (по умолчанию, нет договора) | fake — см. app/sources/bki.py
BKI_PROVIDER_MODE=not_configured
# JSON-фикстура синтетических отчётов для fake — см. scripts/e2e_check.py
BKI_FIXTURE_PATH=

# Кука сессии админки (T13): true (по умолчанию, обязательно в бою) | false —
# только для локальной разработки без HTTPS (см. docs/deployment.md)
COOKIE_SECURE=
