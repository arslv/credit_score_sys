# PostgreSQL
POSTGRES_USER=dialog
POSTGRES_PASSWORD=
POSTGRES_DB=dialog

# Backend
DATABASE_URL=postgresql+asyncpg://dialog:dialog@db:5432/dialog
REDIS_URL=redis://redis:6379/0
LOG_LEVEL=INFO
ENVIRONMENT=development

# fake_partner — заглушка системы заказчика (только для локальной разработки)
FAKE_PARTNER_TOKEN=

# Распознавание фото паспорта (T05)
ANTHROPIC_API_KEY=
OCR_MODEL=claude-sonnet-5

# Синхронизация реестров МВД/Росфинмониторинга (T08): local (по умолчанию, из
# REGISTRIES_DIR) или http. Рабочие URL выгрузок не подтверждены — см.
# backend/app/registries/downloader.py — не переключать на http вслепую.
REGISTRIES_DOWNLOADER=local
MVD_REGISTRY_URL=
ROSFINMON_REGISTRY_URL=
