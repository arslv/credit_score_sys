# PostgreSQL
POSTGRES_USER=dialog
POSTGRES_PASSWORD=
POSTGRES_DB=dialog

# Backend
DATABASE_URL=postgresql+asyncpg://dialog:dialog@db:5432/dialog
REDIS_URL=redis://redis:6379/0
LOG_LEVEL=INFO
ENVIRONMENT=development

# fake_partner — заглушка системы заказчика (только для локальной разработки)
FAKE_PARTNER_TOKEN=

# Распознавание фото паспорта (T05)
ANTHROPIC_API_KEY=
OCR_MODEL=claude-sonnet-5
# anthropic (по умолчанию) | fixture — прогон настоящих Celery-задач без ключа
# (см. scripts/e2e_check.py, app/ocr/factory.py)
OCR_PROVIDER_MODE=anthropic
OCR_FIXTURE_PATH=

# Синхронизация реестров МВД/Росфинмониторинга (T08): local (по умолчанию, из
# REGISTRIES_DIR) или http. Рабочие URL выгрузок не подтверждены — см.
# backend/app/registries/downloader.py — не переключать на http вслепую.
REGISTRIES_DOWNLOADER=local
MVD_REGISTRY_URL=
ROSFINMON_REGISTRY_URL=

# ФССП/ФНС/Федресурс (T09): fake (по умолчанию, для тестов и дев) или http.
# Ключей/доступа нет — не переключать на http без них (см. app/sources/fns.py,
# fssp.py; Федресурс — заглушка, см. app/sources/fedresurs.py).
EXTERNAL_SOURCES_MODE=fake
FNS_BASE_URL=
FSSP_BASE_URL=
FSSP_API_KEY=

# БКИ (T11): not_configured (по умолчанию, нет договора) | fake — см. app/sources/bki.py
BKI_PROVIDER_MODE=not_configured
# JSON-фикстура синтетических отчётов для fake — см. scripts/e2e_check.py
BKI_FIXTURE_PATH=
