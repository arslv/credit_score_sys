# Вариант «за существующим nginx» (docker-compose.behind-proxy.yml): порты
# 80/443 на сервере заняты чужим nginx — он держит HTTPS для нашего поддомена
# и проксирует его сюда (на NGINX_BIND, по умолчанию 127.0.0.1:8088). Здесь —
# только HTTP, статика админки и прокси /api на api:8000.
# Переменные (envsubst): $REQUEST_BODY_MAX_MB, $NGINX_TRUSTED_PROXY.
#
# Адрес клиента (T12, правило про X-Forwarded-For): берём из заголовка
# внешнего nginx, но только если запрос пришёл от него — NGINX_TRUSTED_PROXY
# (адрес прокси-сервера, каким его видит этот сервер; по умолчанию сам
# сервер). Запросы с хоста попадают в контейнер с адреса шлюза docker.

set_real_ip_from ${NGINX_TRUSTED_PROXY};
set_real_ip_from 127.0.0.1;
set_real_ip_from 172.16.0.0/12;
real_ip_header X-Forwarded-For;
real_ip_recursive on;

# Схема (https), с которой клиент пришёл на внешний nginx.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen 80;
    server_name _;

    # Фото паспортов (base64 в теле вебхука, T18) — тот же лимит, что у api
    # (T21) и у внешнего nginx (client_max_body_size там — тоже не меньше).
    client_max_body_size ${REQUEST_BODY_MAX_MB}m;
    error_page 413 = @body_too_large;
    location @body_too_large {
        default_type application/json;
        return 413 '{"detail": "тело запроса больше допустимых ${REQUEST_BODY_MAX_MB} МБ — уменьшите фото (лимиты — docs/integration_contract.md)"}';
    }

    location /api/ {
        proxy_pass http://api:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    location / {
        root /usr/share/nginx/html;
        try_files $uri /index.html;
    }
}
